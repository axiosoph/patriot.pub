{{!< default}}

<div class="container">
    
    {{#author}}
    <!-- Author Header -->
    <header class="author-header-card">
        {{#if profile_image}}
        <div class="author-avatar-wrapper">
            <img class="author-avatar" src="{{profile_image}}" alt="{{name}}" />
        </div>
        {{/if}}
        <div class="author-details-wrapper">
            <h1 class="archive-title">{{name}}</h1>
            {{#if bio}}
            <p class="archive-description">
                {{bio}}
            </p>
            {{else}}
            <p class="archive-description">
                Staff writer and investigative reporter for the Pueblo Patriot.
            </p>
            {{/if}}
            
            {{#has any="twitter,facebook,website,location"}}
            <div class="author-meta">
                {{#if location}}
                <span class="author-location">📍 {{location}}</span>
                {{/if}}
                {{#if website}}
                <a href="{{website}}" target="_blank" rel="noopener">Website</a>
                {{/if}}
                {{#if twitter}}
                <a href="{{social_url type="twitter"}}" target="_blank" rel="noopener">Twitter</a>
                {{/if}}
                {{#if facebook}}
                <a href="{{social_url type="facebook"}}" target="_blank" rel="noopener">Facebook</a>
                {{/if}}
            </div>
            {{/has}}
        </div>
    </header>
    {{/author}}

    <div class="archive-grid">
        
        <!-- Left Columns: Author Post Feed -->
        <div class="broadsheet-column archive-posts-col">
            <div class="archive-feed-grid">
                {{#foreach posts}}
                    <article class="archive-story-card {{post_class}}">
                        {{#if feature_image}}
                        <a class="archive-story-image-link" href="{{url}}">
                            <img class="archive-story-image" src="{{img_url feature_image size="m"}}" alt="{{title}}" />
                        </a>
                        {{/if}}
                        <div class="archive-story-content">
                            <div class="archive-story-meta">
                                {{#if primary_tag}}
                                    <span class="archive-story-tag">{{primary_tag.name}}</span>
                                    <span class="bull">&bull;</span>
                                {{/if}}
                                <span class="archive-story-date">{{date format="MMMM DD, YYYY"}}</span>
                                <span class="bull">&bull;</span>
                                <span class="archive-story-read-time">{{reading_time}}</span>
                            </div>
                            <h2 class="archive-story-title">
                                <a href="{{url}}">{{title}}</a>
                            </h2>
                            <p class="archive-story-excerpt">
                                {{excerpt words="22"}}...
                            </p>
                            <footer class="archive-story-footer">
                                <div class="archive-story-author">
                                    <span class="byline-prefix">By</span>
                                    {{authors autolink="true"}}
                                </div>
                            </footer>
                        </div>
                    </article>
                {{else}}
                    <p class="no-posts">No articles found by this author.</p>
                {{/foreach}}
            </div>

            <!-- Feed Pagination -->
            {{pagination}}
        </div>

        <!-- Right Column: Sidebar -->
        <aside class="broadsheet-column civic-sidebar-col">
            
            <!-- Beats Navigator Widget -->
            <div class="sidebar-widget beats-widget">
                <h3 class="widget-title">Civic Beats</h3>
                <p class="widget-subtitle">Hyperlocal reporting sections covering Pueblo County</p>
                <div class="beats-list">
                    <a href="/tag/politics/" class="beat-tag tag-politics">
                        <span class="beat-dot"></span> Politics & Gov
                    </a>
                    <a href="/tag/business/" class="beat-tag tag-business">
                        <span class="beat-dot"></span> Business & Dev
                    </a>
                    <a href="/tag/community/" class="beat-tag tag-community">
                        <span class="beat-dot"></span> Community Affairs
                    </a>
                    <a href="/tag/culture/" class="beat-tag tag-culture">
                        <span class="beat-dot"></span> Culture & Identity
                    </a>
                    <a href="/tag/nonprofit/" class="beat-tag tag-nonprofit">
                        <span class="beat-dot"></span> Charitable & Org
                    </a>
                </div>
            </div>

            <!-- Citizen Discourse Widget -->
            <div class="sidebar-widget discourse-widget">
                <h3 class="widget-title">Citizen Discourse</h3>
                <p class="widget-text">Pueblo Patriot values constructive civil dialogue. Paid members can participate in our moderated forums on city council decisions, neighborhood affairs, and development policies.</p>
                {{#if @member}}
                    <div class="discourse-status verified">
                        <span class="status-icon">✔</span> Registered Citizen Voice
                    </div>
                {{else}}
                    <a href="#/portal/signup" class="btn btn-primary btn-block">Join the Discourse</a>
                {{/if}}
            </div>
            
        </aside>
    </div>

</div>
