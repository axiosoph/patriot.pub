{{!< default}}

{{#post}}
<article class="container-narrow {{post_class}}">
    
    {{#match @page.show_title_and_feature_image}}
    <!-- Static Page Header -->
    <header class="article-header page-header">
        <h1 class="article-title">{{title}}</h1>
        
        {{#if custom_excerpt}}
        <p class="article-subtitle page-subtitle">
            {{custom_excerpt}}
        </p>
        {{/if}}
        
        <div class="page-divider"></div>
    </header>

    <!-- Page Feature Image -->
    {{#if feature_image}}
    <figure class="article-feature-image-wrapper">
        <img class="article-feature-image" 
            src="{{feature_image}}" 
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" 
        />
        {{#if feature_image_caption}}
            <figcaption class="article-feature-image-caption">
                {{feature_image_caption}}
            </figcaption>
        {{/if}}
    </figure>
    {{/if}}
    {{/match}}

    <!-- Static Page Content -->
    <div class="article-content">
        {{content}}
    </div>

</article>
{{/post}}
