{{!< default}}

<div class="container">
    
    <!-- Top Editorial Section (Three-Column Broadsheet Layout) -->
    <div class="homepage-broadsheet">
        
        <!-- Left Column: Secondary Coverage -->
        <div class="broadsheet-column secondary-col">
            <h3 class="column-title">Secondary Coverage</h3>
            {{#foreach posts from="2" to="4"}}
                <article class="secondary-story-card {{post_class}}">
                    <div class="story-meta">
                        {{#if primary_tag}}
                            {{#primary_tag}}
                                <a href="{{url}}" class="story-tag">{{name}}</a>
                            {{/primary_tag}}
                            <span class="bull">&bull;</span>
                        {{/if}}
                        <span class="story-date">{{date format="MMM DD"}}</span>
                    </div>
                    <h4 class="story-title">
                        <a href="{{url}}">{{title}}</a>
                    </h4>
                    <p class="story-excerpt">
                        {{excerpt words="20"}}...
                    </p>
                </article>
            {{else}}
                <div class="no-posts-small">
                    No secondary stories available.
                </div>
            {{/foreach}}
        </div>
        
        <!-- Center Column: Lead Story -->
        <div class="broadsheet-column lead-story-col">
            {{#foreach posts limit="1"}}
                <article class="lead-story-card {{post_class}}">
                    {{#if feature_image}}
                    <a class="lead-story-image-link" href="{{url}}">
                        <img class="lead-story-image"
                            srcset="{{img_url feature_image size="s"}} 300w,
                                    {{img_url feature_image size="m"}} 600w,
                                    {{img_url feature_image size="l"}} 1000w"
                            sizes="(max-width: 900px) 100vw, 600px"
                            src="{{img_url feature_image size="m"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        />
                    </a>
                    {{/if}}
                    
                    <div class="lead-story-content">
                        <div class="lead-story-meta">
                            {{#if primary_tag}}
                                {{#primary_tag}}
                                    <span class="lead-story-tag">{{name}}</span>
                                {{/primary_tag}}
                                <span class="bull">&bull;</span>
                            {{/if}}
                            <span class="lead-story-date">{{date format="MMMM DD, YYYY"}}</span>
                            <span class="bull">&bull;</span>
                            <span class="lead-story-read-time">{{reading_time}}</span>
                        </div>
                        
                        <h2 class="lead-story-title">
                            <a href="{{url}}">{{title}}</a>
                        </h2>
                        
                        <p class="lead-story-excerpt">
                            {{excerpt words="40"}}...
                        </p>
                        
                        <footer class="lead-story-footer">
                            <div class="lead-story-author">
                                <span class="byline-prefix">By</span>
                                {{authors autolink="true"}}
                            </div>
                            <a href="{{url}}" class="read-more-link">Read Full Story &rarr;</a>
                        </footer>
                    </div>
                </article>
            {{else}}
                <div class="no-posts">
                    Constructing the press. Articles are being queued for publication.
                </div>
            {{/foreach}}
        </div>

        <!-- Right Column: Civic Sidebar -->
        <aside class="broadsheet-column civic-sidebar-col">
            
            <!-- Beats Navigator Widget -->
            <div class="sidebar-widget beats-widget">
                <h3 class="widget-title">Civic Beats</h3>
                <p class="widget-subtitle">Hyperlocal reporting sections covering Pueblo County</p>
                <div class="beats-list">
                    <a href="/tag/politics/" class="beat-tag tag-politics">
                        <span class="beat-dot"></span> Politics & Gov
                    </a>
                    <a href="/tag/business/" class="beat-tag tag-business">
                        <span class="beat-dot"></span> Business & Dev
                    </a>
                    <a href="/tag/community/" class="beat-tag tag-community">
                        <span class="beat-dot"></span> Community Affairs
                    </a>
                    <a href="/tag/culture/" class="beat-tag tag-culture">
                        <span class="beat-dot"></span> Culture & Identity
                    </a>
                    <a href="/tag/nonprofit/" class="beat-tag tag-nonprofit">
                        <span class="beat-dot"></span> Charitable & Org
                    </a>
                </div>
            </div>

            <!-- Citizen Discourse Widget -->
            <div class="sidebar-widget discourse-widget">
                <h3 class="widget-title">Citizen Discourse</h3>
                <p class="widget-text">Pueblo Patriot values constructive civil dialogue. Paid members can participate in our moderated forums on city council decisions, neighborhood affairs, and development policies.</p>
                {{#if @member}}
                    <div class="discourse-status verified">
                        <span class="status-icon">✔</span> Registered Citizen Voice
                    </div>
                {{else}}
                    <a href="#/portal/signup" class="btn btn-primary btn-block">Join the Discourse</a>
                {{/if}}
            </div>
            
        </aside>
    </div>

    <!-- Sponsor Strip (Charter Partner Showcase) -->
    <div class="sponsor-strip">
        <div class="sponsor-label">Community Partner Spotlight</div>
        <div class="sponsor-body">
            <div class="sponsor-info">
                <h4 class="sponsor-name">Mesa Junction Bakery & Café</h4>
                <p class="sponsor-tagline">Proudly sponsoring independent journalism in Pueblo. Fresh sourdough, pastries, and locally roasted coffee daily in historic Mesa Junction.</p>
            </div>
            <a href="https://mesajunctionbakery.example.com" target="_blank" rel="noopener" class="btn btn-secondary sponsor-btn">Visit Local Partner</a>
        </div>
    </div>

    <!-- Secondary Feed (Remaining Posts in Grid) -->
    <h2 class="section-title">Latest Local Coverage</h2>
    <div class="post-feed">
        {{#foreach posts from="5"}}
            {{> "card"}}
        {{/foreach}}
    </div>

    <!-- Feed Pagination -->
    {{pagination}}

    <!-- Call to Action Banner -->
    {{^if @member}}
    <section class="newsletter-cta">
        <div class="container-narrow">
            <h3>Be notified when we publish</h3>
            <p>Get independent, investigative local reporting, civic updates, and neighborhood features sent directly to your inbox. No trackers, no spam, no sold data.</p>
            
            <form class="signup-form" data-members-form="subscribe">
                <input data-members-email type="email" placeholder="your@email.com" required autocomplete="email" aria-label="Email address" />
                <button type="submit">Subscribe</button>
            </form>
            
            <div class="success-message" style="display: none; margin-top: var(--space-md); font-family: var(--font-mono); color: var(--color-sun); font-size: 0.9rem;">
                ✔ Subscription verification email dispatched! Please check your inbox.
            </div>
            <div class="error-message" style="display: none; margin-top: var(--space-md); font-family: var(--font-mono); color: var(--color-brick); font-size: 0.9rem;">
                ✘ An error occurred. Please try again.
            </div>
        </div>
    </section>
    {{/if}}

</div>

<script>
    // Native Ghost member form handlers (toggling success/error classes)
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector("[data-members-form='subscribe']");
        const successMsg = document.querySelector(".success-message");
        const errorMsg = document.querySelector(".error-message");

        if (form) {
            form.addEventListener("submit", (e) => {
                const observer = new MutationObserver((mutations) => {
                    mutations.forEach((mutation) => {
                        if (mutation.attributeName === "class") {
                            const classes = form.className;
                            if (classes.includes("success")) {
                                if (successMsg) successMsg.style.display = "block";
                                if (errorMsg) errorMsg.style.display = "none";
                            } else if (classes.includes("error")) {
                                if (successMsg) successMsg.style.display = "none";
                                if (errorMsg) errorMsg.style.display = "block";
                            }
                        }
                    });
                });
                observer.observe(form, { attributes: true });
            });
        }
    });
</script>
