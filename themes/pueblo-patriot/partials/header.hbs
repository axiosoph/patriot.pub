<header class="site-header">
    <div class="container">
        
        <!-- Masthead -->
        <div class="header-masthead">
            <a href="{{@site.url}}">
                <span class="masthead-the">THE</span>
                <span class="masthead-title">Pueblo Patriot</span>
            </a>
        </div>

        <!-- Header Utility Bar -->
        <div class="header-top">
            <div class="header-date">
                <span id="current-date">Pueblo, Colorado</span>
            </div>
            <div class="header-tagline">
                {{#if @site.description}}
                    {{@site.description}}
                {{else}}
                    Pueblo's Independent Voice
                {{/if}}
            </div>
            <div class="header-meta">
                <span>Verifiable Truth · Sovereign Source</span>
            </div>
        </div>

        <!-- Navigation Bar -->
        <nav class="header-nav">
            <!-- Mobile Menu Toggle Button -->
            <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
                <span class="menu-toggle-icon"></span>
            </button>

            {{navigation}}
            
            <div class="nav-actions">
                {{#if @member}}
                    <a href="#/portal/account" class="btn btn-secondary header-btn-signin">Account</a>
                {{else}}
                    <a href="#/portal/signin" class="btn btn-secondary header-btn-signin">Sign In</a>
                    <a href="#/portal/signup" class="btn btn-primary header-btn-subscribe">Subscribe</a>
                {{/if}}
            </div>

            <!-- Collapsible Mobile Menu Drawer Actions -->
            <div class="mobile-drawer-actions">
                {{#if @member}}
                    <a href="#/portal/account" class="btn btn-secondary btn-block">Account Details</a>
                {{else}}
                    <a href="#/portal/signin" class="btn btn-secondary btn-block">Sign In to Account</a>
                {{/if}}
            </div>
        </nav>
        
    </div>
</header>

<script>
    // Format and display local date on the masthead (classic newspaper style)
    document.addEventListener("DOMContentLoaded", () => {
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateStr = new Date().toLocaleDateString('en-US', options);
        const dateEl = document.getElementById("current-date");
        if (dateEl) {
            dateEl.textContent = `Pueblo, CO · ${dateStr}`;
        }

        // Mobile Hamburger Menu Toggler
        const nav = document.querySelector(".header-nav");
        const toggle = document.querySelector(".menu-toggle");
        if (toggle && nav) {
            toggle.addEventListener("click", () => {
                const isOpen = nav.classList.toggle("menu-open");
                toggle.setAttribute("aria-expanded", isOpen);
            });
        }
    });
</script>
