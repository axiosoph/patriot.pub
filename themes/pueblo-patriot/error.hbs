{{!< default}}

<div class="container">
    <div class="error-page-container">
        <div class="error-card">
            <span class="error-code-kicker">Bulletin {{statusCode}}</span>
            <h1 class="error-heading">Page Not Found</h1>
            
            {{#if message}}
                <p class="error-message-text">{{message}}</p>
            {{else}}
                <p class="error-message-text">The dispatch you are seeking has been archived, moved, or does not exist.</p>
            {{/if}}

            <div class="error-divider"></div>

            <p class="error-suggestion">
                Return to the front page to read our latest coverage and investigative dispatches.
            </p>

            <div class="error-actions">
                <a href="{{@site.url}}" class="btn btn-primary">Return to Homepage</a>
            </div>
        </div>
    </div>
</div>
